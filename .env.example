# Create a Notion integration at https://www.notion.so/my-integrations,
# then share the "Installer World Cup" database with it (••• menu on the
# database -> Connections -> your integration). Paste the integration
# secret below.
NOTION_TOKEN=

# Optional: only needed if the Installer World Cup database gets moved/duplicated.
# Default is already wired to the database created for this competition.
NOTION_DATABASE_ID=

PORT=
